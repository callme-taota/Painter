  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main task action; studio uses the same colors without the public control shadow.",
      "html": "<button class=\"ds-button-primary\">保存文章</button>",
      "css": ".ds-button-primary{font:500 var(--control-font,13px)/var(--control-leading,20px) var(--font-ui,sans-serif);min-height:var(--control-height,36px);padding:var(--control-pad-y,7px) var(--control-pad-x,12px);border-radius:var(--radius-control,6px);cursor:pointer;transition:background .18s ease-out;background:var(--accent,#18181b);color:var(--primary-ink,#fafafa);border:1px solid transparent;box-shadow:var(--shadow-xs,0 1px 2px rgb(0 0 0 / .05))}.ds-button-primary:hover{background:color-mix(in srgb,var(--accent,#18181b) 88%,var(--bg,#fff))}.ds-button-primary:focus-visible{outline:2px solid var(--focus-ring,#52525b);outline-offset:3px}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting action with a fine stroke.",
      "html": "<button class=\"ds-button-secondary\">保存文章</button>",
      "css": ".ds-button-secondary{font:500 var(--control-font,13px)/var(--control-leading,20px) var(--font-ui,sans-serif);min-height:var(--control-height,36px);padding:var(--control-pad-y,7px) var(--control-pad-x,12px);border-radius:var(--radius-control,6px);cursor:pointer;transition:background .18s ease-out;background:var(--paper,#fff);color:var(--ink,#18181b);border:1px solid var(--line,#e4e4e7)}.ds-button-secondary:hover{background:var(--subtle,#f4f4f5)}.ds-button-secondary:focus-visible{outline:2px solid var(--focus-ring,#52525b);outline-offset:3px}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Low-emphasis toolbar or supporting action.",
      "html": "<button class=\"ds-button-quiet\">保存文章</button>",
      "css": ".ds-button-quiet{font:500 var(--control-font,13px)/var(--control-leading,20px) var(--font-ui,sans-serif);min-height:var(--control-height,36px);padding:var(--control-pad-y,7px) var(--control-pad-x,12px);border-radius:var(--radius-control,6px);cursor:pointer;transition:background .18s ease-out;background:transparent;color:var(--ink,#18181b);border:1px solid transparent}.ds-button-quiet:hover{background:var(--subtle,#f4f4f5)}.ds-button-quiet:focus-visible{outline:2px solid var(--focus-ring,#52525b);outline-offset:3px}.ds-button-quiet:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Ordinary editable field; mobile/coarse input text grows to16px.",
      "html": "<label class=\"ds-field-label\">标题<input class=\"ds-field\" value=\"从一个想法开始\"></label>",
      "css": ".ds-field-label{display:grid;gap:6px;font:400 13px/20px var(--font-ui,sans-serif);color:var(--muted,#66666e)}.ds-field{background:var(--paper,#fff);color:var(--ink,#18181b);border:1px solid var(--line,#e4e4e7);border-radius:var(--radius-control,6px);min-height:var(--control-height,36px);padding:var(--control-pad-y,7px) var(--control-pad-x,12px);font:400 14px/20px var(--font-ui,sans-serif);box-shadow:var(--shadow-xs,0 1px 2px rgb(0 0 0 / .05))}.ds-field:hover{border-color:var(--muted,#66666e)}.ds-field:focus-visible{outline:2px solid var(--focus-ring,#52525b);outline-offset:3px}@media(max-width:720px),(pointer:coarse){.ds-field{font-size:16px}}"
    },
    {
      "name": "Workbench Destination",
      "kind": "nav",
      "refersTo": "work-navigation-active",
      "description": "Neutral active destination inside the existing grouped sidebar.",
      "html": "<nav class=\"ds-work-nav\" aria-label=\"内容管理\"><a href=\"#articles\" aria-current=\"page\">文章管理</a><a href=\"#tags\">标签管理</a></nav>",
      "css": ".ds-work-nav{display:grid;gap:2px;padding:12px;background:var(--sidebar,#fafafa);font:400 13px/20px var(--font-ui,sans-serif)}.ds-work-nav a{display:flex;align-items:center;min-height:var(--control-height,36px);padding:var(--control-pad-y,7px) 10px;border-radius:var(--radius-control,6px);color:var(--muted,#66666e);text-decoration:none}.ds-work-nav a[aria-current=page],.ds-work-nav a:hover{background:var(--subtle,#f4f4f5);color:var(--ink,#18181b)}.ds-work-nav a[aria-current=page]{font-weight:500}.ds-work-nav a:focus-visible{outline:2px solid var(--focus-ring,#52525b);outline-offset:3px}"
    },
    {
      "name": "Selected Tag",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Inset selected token; no nested vertical padding layer.",
      "html": "<button class=\"ds-tag\" aria-label=\"移除标签 写作\">写作<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:6px;min-height:var(--control-inset-height,28px);padding:2px 8px;background:var(--subtle,#f4f4f5);color:var(--ink,#18181b);border:0;border-radius:var(--radius-item,4px);font:400 13px/20px var(--font-ui,sans-serif);cursor:pointer}.ds-tag:hover{background:var(--line,#e4e4e7)}.ds-tag:focus-visible{outline:2px solid var(--focus-ring,#52525b);outline-offset:3px}"
    },
    {
      "name": "Studio Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Solid content panel; state belongs to actual controls inside it.",
      "html": "<section class=\"ds-panel\"><h2>文章信息</h2><p>摘要、标签与封面</p></section>",
      "css": ".ds-panel{background:var(--paper,#fff);color:var(--ink,#18181b);border:1px solid var(--line,#e4e4e7);border-radius:var(--radius-surface,12px);padding:24px;box-shadow:none;font-family:var(--font-ui,sans-serif)}.ds-panel h2{font:600 16px/24px var(--font-ui,sans-serif);letter-spacing:-.015em;margin:0 0 20px}.ds-panel p{font:400 14px/22px var(--font-ui,sans-serif);color:var(--muted,#66666e);margin:0}@media(max-width:720px){.ds-panel{padding:20px}}"
