# Generated by ./install.sh or scripts/configure.sh; keep this real file private.
# PAINTER_IMAGE is optional: set a real published explicit tag/digest for no-build deployment.
PAINTER_DEPLOY_MODE=local
COMPOSE_PROJECT_NAME=painter-next
PAINTER_IMAGE=
# Generate real independent secrets using ./scripts/configure.sh --local.
# No usable credentials are committed.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8080
# Set HTTPS public origin and a restricted connector CIDR when using Tunnel.
ENFORCE_PUBLIC_HTTPS=false
TRUSTED_PROXY_CIDRS=
TRUST_CLOUDFLARE_CONNECTING_IP=false
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
PUBLIC_HOST=localhost
DB_ADMIN_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_APP_PASSWORD=
APP_ENCRYPTION_KEY=
ANALYTICS_HMAC_KEY=
# Random installation code, generated for a new deployment; web setup closes permanently after completion.
SETUP_TOKEN=
# GitHub OAuth App: callback ${PUBLIC_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your immutable numeric GitHub user ID, never your username.
BOOTSTRAP_GITHUB_ID=
