  "narrative": {
    "northStar": "A clear personal publication",
    "overview": "Personal identity comes from the configured site name, introduction, Painter logo and saved writing. The shared visual language is neutral, compact and legible: sans typography, solid surfaces, fine borders and black/white primary actions. Public pages leave room for reading; the workbench concentrates information around the current task.\n\nThe workbench adapts the inset shell, grouped sidebar and breadcrumb hierarchy of official shadcn [dashboard-01](https://ui.shadcn.com/view/new-york-v4/dashboard-01) and [sidebar-07](https://ui.shadcn.com/view/new-york-v4/sidebar-07). This is a visual adaptation of the existing Vue components, with no React or Radix migration. Saved covers, author backgrounds and actual business data retain their own meaning.",
    "keyCharacteristics": [
      "Neutral light and dark surfaces with clear text contrast.",
      "One compact control and radius vocabulary across public and workbench routes.",
      "Solid inset workspace with restrained task hierarchy and two-level navigation.",
      "Readable public documents and progressive motion enhancements."
    ],
    "rules": [
      {
        "name": "Neutral Chrome",
        "body": "Shared interface chrome uses the neutral roles. Article artwork and user-selected author backgrounds remain saved content and do not define interface tokens.",
        "section": "colors"
      },
      {
        "name": "Task Type",
        "body": "Shared sans typography carries navigation, task headings, tables and forms. Keep reading and source scales independent from compact control text.",
        "section": "typography"
      },
      {
        "name": "Shared Shape",
        "body": "Reuse the semantic radius token for the element's role. Component-specific values must not create an independent control scale.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** use the shared neutral tokens in both themes, including the sidebar/paper distinction.",
      "**Do** preserve the 36px/44px control targets, 28px/36px inset elements and semantic radius scale.",
      "**Do** keep real content, accessible states, keyboard focus and local overflow behavior visible.",
      "**Do** keep reading, source and task typography distinct within the shared sans family.",
      "**Do** preserve static reading and reduced-motion fallbacks when adding enhancement."
    ],
    "donts": [
      "**Don't** reintroduce blue selected capsules, glass task surfaces or the former serif display system.",
      "**Don't** migrate frameworks or add a component runtime merely to imitate the reference appearance.",
      "**Don't** resize controls by adding nested vertical padding, clip choice text or allow page-wide horizontal overflow.",
      "**Don't** turn article artwork, user backgrounds or home motion into global interface tokens.",
      "**Don't** imply that a visual rewrite changes permissions, settings, data or publication behavior."
    ]
  }
